{
  "$comment": "Schema for the model's diagnosis. TODO-ALIGN: map to the organiser's scoring schema when it is released.",
  "type": "object",
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "symptoms": {"type": "array", "items": {"type": "string"}},
    "root_cause": {
      "type": "object",
      "properties": {
        "service": {"type": "string"},
        "category": {"type": "string"},
        "description": {"type": "string"}
      },
      "required": ["service", "category", "description"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"id": {"type": "string", "pattern": "^\\[?E[0-9]+\\]?$"}, "why": {"type": "string"}},
        "required": ["id", "why"]
      }
    },
    "ruled_out": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["summary", "root_cause", "confidence", "evidence"]
}
