# Shared model settings for main.py and scripts.check_setup (local Ollama)
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TIMEOUT=120
# Hosted alternative: set model, API base and key for your provider.
# Legacy ollama_chat/ model prefixes and LLM_API_BASE are also accepted.

USE_MOCK=0
MOCK_MODE=default
HTTP_TIMEOUT=12
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:8080/jaeger/ui
# Blank: discover host port using docker port opensearch 9200
OPENSEARCH_URL=
OPENSEARCH_CONTAINER=opensearch
DOCKER_NETWORK=opentelemetry-demo

# Blank: discover from Prometheus series and OpenSearch field capabilities.
# Run python -m scripts.discover before the checkpoint; override as needed.
METRIC_CALLS=
METRIC_DURATION=
METRIC_SERVICE_LABEL=
# Required if the bucket name doesn't state seconds or milliseconds: s or ms
METRIC_DURATION_UNIT=
# Blank: infer error status from series labels; override only after discovery.
METRIC_ERROR_SELECTOR=
LOGS_INDEX=otel-logs-*
LOGS_SERVICE_FIELD=
LOGS_LEVEL_FIELD=
LOGS_BODY_FIELD=
