# LLM (any litellm model string)
# Local (default): Ollama serving Qwen3 8B. Use the ollama_chat/ prefix - it supports tool calling.
LLM_MODEL=ollama_chat/qwen3:8b
LLM_API_BASE=http://localhost:11434

# Telemetry endpoints
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:8080/jaeger/ui

# OpenSearch has a random host port; leave blank to auto-discover via `docker port opensearch 9200`
OPENSEARCH_URL=
