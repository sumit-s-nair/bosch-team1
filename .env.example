# --- LLM: local Ollama, native /api/chat (no hosted keys at this event)
LLM_MODEL=qwen3:8b
LLM_API_BASE=http://localhost:11434
LLM_NUM_CTX=16384
LLM_TIMEOUT=300

# --- Model chain: tried in order, first that answers wins. Hosted ones are used only if their key is set.
# Declare every hosted model in the team form. Free keys: console.groq.com, aistudio.google.com
LLM_CHAIN=groq,gemini,xai,local
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# --- Telemetry endpoints (defaults match the demo's compose files)
HTTP_TIMEOUT=12
PROMETHEUS_URL=http://localhost:9090
# Base before /api. The agent auto-detects Jaeger's v3 or legacy API under it.
JAEGER_URL=http://localhost:8080/jaeger/ui
# Blank: discover host port via `docker port opensearch 9200`
OPENSEARCH_URL=
OPENSEARCH_CONTAINER=opensearch
DOCKER_NETWORK=opentelemetry-demo

# --- Log field overrides (blank = auto-discover from OpenSearch field caps)
LOGS_INDEX=otel-logs-*
LOGS_SERVICE_FIELD=
LOGS_LEVEL_FIELD=
LOGS_BODY_FIELD=
LOGS_SEVERITY_NUMBER_FIELD=severity.number

# --- Action API (our own service, the only thing allowed to change the demo): python -m action_api.server
# Leave ACTION_API_URL blank for dry-run only. Token: any long random string, the same for API and agent.
ACTION_API_URL=http://127.0.0.1:8090
ACTION_API_TOKEN=change-me-to-a-long-random-string
ACTION_API_PORT=8090
DEMO_BASE_URL=http://localhost:8080
